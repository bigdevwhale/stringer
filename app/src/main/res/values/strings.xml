    <!-- Welcome and settings -->
    <string name="welcome_tape">The district paper needs a correspondent. Ordinary things on every walk</string>
    <string name="welcome_title">The paper takes you on</string>
    <string name="welcome_1">Before a walk, ask the editor for a telegram: one ordinary thing to shoot, with a twist.</string>
    <string name="welcome_2">Shoot it with the phone\'s camera and write one line under it, as in a paper.</string>
    <string name="welcome_3">The frames fill the week\'s rubrics. Every Sunday a new issue comes out.</string>
    <string name="welcome_4">Longer investigations fill up over weeks: the district\'s alphabet, its doors, its cats.</string>
    <string name="welcome_go">Join the staff</string>
